#!/bin/sh
# 推送前检查。两件事，一件拦截、一件提醒。
#
# ── 一、拦截直推 main ────────────────────────────────────────────────────
# 为什么（2026-11-01）：在此之前所有提交都直接进 main。没有 PR 就没有
# 「另一个人（或另一个 agent）看一眼」的机会，而本仓库有过一次公开泄露，
# 靠的从来不是小心，是流程里有个人拦住。远端分支保护才是真保护，本地这道
# 只是兜底——它拦得住手滑，拦不住 `git push --no-verify` 或别的机器。
#
# 例外：ALLOW_MAIN_PUSH=1 git push origin main
# 什么时候可以用：修 CI 自身、仓库初始配置这类「保护还没生效」的引导期操作。
# 用完记得说明理由，别让它变成习惯。
#
# ── 二、提醒「改了前端没发布」────────────────────────────────────────────
# 为什么需要（2026-10-31 的教训）：那次重构（删 cloud.js、改 main.js/store.js）
# 本地构建过了、冒烟过了、git 也推了，**线上打开还是昨晚那版**——因为「改代码」
# 和「上线」是两个动作，中间靠人记得。这个提醒就是那个「记得」。
# 它**不阻断推送**：发布是外部动作，可能失败、可能要人确认，不该卡住 git。
#
# 安装：cp tools/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# 卸载：rm .git/hooks/pre-push

MAIN_REF="refs/heads/main"
ZERO="0000000000000000000000000000000000000000"
blocked=""

# 先把 stdin 读完：后面还要跑命令，不能留半个管道。
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "$MAIN_REF" ] || continue
  # 删除远程 main 不拦（那是另一类操作，需要单独判断）
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "${ALLOW_MAIN_PUSH:-0}" = "1" ]; then
    echo "⚠️  ALLOW_MAIN_PUSH=1：跳过 main 保护，直接推了。" >&2
    continue
  fi
  blocked="$local_ref"
done

if [ -n "$blocked" ]; then
  cat >&2 <<'EOF'

┌──────────────────────────────────────────────────────────────┐
│  ✗  不能直接推 main。                                        │
├──────────────────────────────────────────────────────────────┤
│  这个仓库的 main 只接受 PR 合并。                            │
│  ⚠️ 远端没有分支保护（免费账号的私有仓库不支持），           │
│     这道钩子是唯一的一道，绕过它没人拦得住。                 │
│                                                              │
│  正确做法：                                                  │
│    python3 tools/ci/wt.py new feat/你的功能名                │
│    cd .worktrees/feat-你的功能名                             │
│    ……改代码，跑 python3 tools/ci/check.py……                  │
│    git add -A && git commit -m '...'                         │
│    git push -u origin feat/你的功能名                        │
│    然后开 PR，等 check 变绿再合并                            │
│                                                              │
│  已经提交在 main 上了？不用撤销，改成推分支：                │
│    git push origin main:feat/临时分支名                      │
│    再开 PR 把这几个 commit 合回来                            │
│                                                              │
│  确实需要直推（引导期配置等）：                              │
│    ALLOW_MAIN_PUSH=1 git push origin main                    │
└──────────────────────────────────────────────────────────────┘

EOF
  exit 1
fi

# ── 二、部署提醒（不阻断）────────────────────────────────────────────────
cd "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || exit 0
[ -f tools/deploy.py ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

OUT=$(NO_PROXY='*' no_proxy='*' python3 tools/deploy.py --check 2>/dev/null)

case "$OUT" in
  *republish*)
    echo ""
    echo "┌────────────────────────────────────────────────────────────┐"
    echo "│  ⚠️  前端代码有变更，但还没发布到线上。                     │"
    echo "├────────────────────────────────────────────────────────────┤"
    echo "│  数据变了 → 热更新，秒级：                                 │"
    echo "│      python3 tools/deploy.py                               │"
    echo "│  代码变了 → 必须重新发布应用（热更新改不了 js/css）：       │"
    echo "│      在 WorkBuddy 里发布，然后登记：                        │"
    echo "│      python3 tools/deploy.py --mark-app-deployed           │"
    echo "└────────────────────────────────────────────────────────────┘"
    echo ""
    ;;
esac
exit 0
