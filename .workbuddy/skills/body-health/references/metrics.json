{
 "version": 3,
 "_comment": "指标注册表 v3（2026-10-25）。**这是指标定义的唯一权威来源**：语义（label/unit/kind/role）、可比条件、聚合方式（agg）、达标方向（dir）、以及「达标线是哪条规则」（thresholds 声明式表达式）。阈值数值仍在 rules.json，本表只声明映射与换算；解析器是 scripts/metricdefs.py，缺路径会直接报错（以前静默返回 None，指标会悄悄失去达标判定）。thresholds 四键：goal=单元/展示达标线（units.judge 用）；judge=判读线（报告判黄用，未声明退回 goal）；severe=红线段；delta=差值型判据（如静息心率抬升）。表达式只允许 数字 / 点号路径 / + - * / 与括号。",
 "kinds": {
  "point": "点观测：某个时刻的一个读数（体测、称重、血压）。t 是时刻。",
  "interval": "区间观测：某个时间段上的聚合量（一天的步数、一夜的 HRV）。t=t_start, t_end=区间终点，coverage=实际覆盖比例。",
  "derived": "派生观测：由其他观测算出（BMI、FFM、睡眠阶段占比等）。必须记录 derived_from，否则无法级联重算与溯源。"
 },
 "roles": {
  "anchor": "绝对量：数值本身有意义（kg / cm / %），是定标用。",
  "proxy": "代理量：设备用间接信号推出来的（BIA 体脂、Garmin VO2max），只可与同法比较。",
  "self_report": "自报量：人的主观回答，没有设备误差但有回忆偏差。"
 },
 "metrics": {
  "weight_kg": {
   "label": "体重",
   "unit": "kg",
   "kind": "point",
   "cadence": "daily",
   "role": "anchor",
   "error_ref": "weight_kg",
   "comparable_on": [
    "method",
    "device",
    "conditions.fasted",
    "conditions.same_scale"
   ],
   "note": "两个源：家用秤（晨起空腹）与 InBody H40 内建秤（晚间）。**方法不同即不可相减**，只能各自成序列或做漂移检测。刻意不进 units 聚合——一旦合并就会把两个口径平均成一个不存在的数。"
  },
  "body_fat_pct": {
   "label": "体脂率",
   "unit": "%",
   "kind": "point",
   "cadence": "monthly",
   "role": "proxy",
   "error_ref": "body_fat_pct",
   "comparable_on": [
    "method",
    "device",
    "conditions.fasted",
    "conditions.time_of_day"
   ],
   "note": "BIA 是代理量，跨机型/跨方法（如 Navy 皮尺）**不可比、不可平均**。多方法并存时应给区间而不是择一。"
  },
  "ffm_kg": {
   "label": "去脂体重",
   "unit": "kg",
   "kind": "derived",
   "cadence": "monthly",
   "role": "proxy",
   "error_ref": "ffm_kg",
   "comparable_on": [
    "method",
    "device",
    "conditions.fasted"
   ],
   "note": "所有减脂目标路径的分母。它一漂，「目标 85.9kg」整个跟着错。"
  },
  "skeletal_muscle_kg": {
   "label": "骨骼肌量",
   "unit": "kg",
   "kind": "point",
   "cadence": "monthly",
   "role": "proxy",
   "error_ref": "skeletal_muscle_kg",
   "comparable_on": [
    "method",
    "device"
   ],
   "note": "受水合影响大。±1.5kg 内只能说「没有证据表明流失」。"
  },
  "visceral_fat_level": {
   "label": "内脏脂肪等级",
   "unit": "级",
   "kind": "point",
   "cadence": "monthly",
   "role": "proxy",
   "error_ref": "visceral_fat_level",
   "comparable_on": [
    "method",
    "device"
   ],
   "note": "整数刻度、±1 级。"
  },
  "waist_cm": {
   "label": "腰围",
   "unit": "cm",
   "kind": "point",
   "cadence": "monthly",
   "role": "anchor",
   "error_ref": "waist_cm",
   "comparable_on": [
    "method",
    "conditions.fasted",
    "conditions.time_of_day"
   ],
   "note": "**未采集**。登记在此是为了让框架「空着也能接」——数据一到就自动进入体系，不需要改任何代码。"
  },
  "calf_cm": {
   "label": "小腿围",
   "unit": "cm",
   "kind": "point",
   "cadence": "monthly",
   "role": "anchor",
   "error_ref": "waist_cm",
   "comparable_on": [
    "method",
    "conditions.time_of_day"
   ],
   "note": "**未采集**。同 waist_cm，占位登记。"
  },
  "hrv_ms": {
   "label": "HRV",
   "unit": "ms",
   "kind": "interval",
   "cadence": "daily",
   "role": "proxy",
   "error_ref": "hrv_ms",
   "agg": "median",
   "dir": "band",
   "comparable_on": [
    "method",
    "device"
   ],
   "note": "夜间均值。单晚 ±10ms 是噪声（本机实测 SD 10.0）。聚合用**中位数**——偏态，单夜暴跌会把周均值带跑。",
   "precision": 0,
   "check": true,
   "frontend_key": "hrv",
   "band": "@personal",
   "band_fallback": "hrv.fallback_band"
  },
  "rhr_bpm": {
   "label": "静息心率",
   "unit": "bpm",
   "kind": "point",
   "cadence": "daily",
   "role": "proxy",
   "error_ref": "rhr_bpm",
   "agg": "mean",
   "dir": "below",
   "comparable_on": [
    "method",
    "device"
   ],
   "note": "±2 bpm 是噪声（门槛 5）。",
   "precision": 0,
   "frontend_key": "rhr",
   "thresholds": {
    "goal": "profile.rhr_7d_avg + rhr.elevated_delta_bpm",
    "delta": "rhr.elevated_delta_bpm"
   }
  },
  "sleep_h": {
   "label": "睡眠时长",
   "unit": "h",
   "kind": "interval",
   "cadence": "daily",
   "role": "proxy",
   "error_ref": "sleep_h",
   "agg": "mean",
   "dir": "above",
   "comparable_on": [
    "method",
    "device"
   ],
   "note": "区间＝一夜。日间摆动 ±0.9h。达标线 = rules.sleep.min_healthy_duration_min / 60。",
   "precision": 1,
   "check": true,
   "frontend_key": "sleep_h",
   "thresholds": {
    "goal": "sleep.min_healthy_duration_min / 60",
    "judge": "sleep.min_healthy_duration_min / 60",
    "severe": "cross.short_sleep_min / 60"
   }
  },
  "sleep_deep_pct": {
   "label": "深睡占比",
   "unit": "%",
   "kind": "derived",
   "cadence": "daily",
   "role": "proxy",
   "error_ref": "sleep_h",
   "agg": "mean",
   "dir": "band",
   "comparable_on": [
    "method",
    "device"
   ],
   "note": "占比类指标**没有登记 mdc**，只并列数字、不判趋势方向（2026-10-22 定）。",
   "precision": 1,
   "band": "sleep.deep_pct_optimal"
  },
  "sleep_rem_pct": {
   "label": "REM 占比",
   "unit": "%",
   "kind": "derived",
   "cadence": "daily",
   "role": "proxy",
   "error_ref": "sleep_h",
   "agg": "mean",
   "dir": "band",
   "comparable_on": [
    "method",
    "device"
   ],
   "note": "同上，占比不判趋势。REM 由「起床时刻 + 睡眠连续性」决定，不由入睡钟点决定（10-22 vs 10-23 对照）。",
   "precision": 1,
   "band": "sleep.rem_pct_optimal"
  },
  "sleep_hr_avg": {
   "label": "睡眠心率均值",
   "unit": "bpm",
   "kind": "interval",
   "cadence": "daily",
   "role": "proxy",
   "error_ref": "rhr_bpm",
   "agg": "mean",
   "dir": "below",
   "comparable_on": [
    "method",
    "device"
   ],
   "note": "基准 = profile.rhr_7d_avg + sleep_hr.score.allowance_bpm；无登记 mdc，只作辅证。",
   "precision": 0,
   "thresholds": {
    "goal": "profile.rhr_7d_avg + sleep_hr.score.allowance_bpm"
   }
  },
  "steps_daily": {
   "label": "日步数",
   "unit": "步",
   "kind": "interval",
   "cadence": "daily",
