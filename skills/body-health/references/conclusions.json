 "_comment": "结论注册表（2026-11-03 建）。**回答一个问题：哪条日级断言可以被窗口化、用什么算子、窗口上怎么说。** 判定逻辑不在这里（在 assertions.py），阈值数值不在这里（在 rules.json）；本表只声明「时间形态」与「措辞」。未登记的断言 id 视为契约破坏：assertions.py 重建时直接报错，不许悄悄多出一条没人定义过时间语义的结论。",
 "version": 1,
 "kinds": {
  "judge": "有判定含义，可按窗口聚合（operator 必须给）",
  "cross": "归因型：多个 L1 条件同时成立。窗口层只做共现计数，禁止陈述为因果",
  "passthrough": "信源自己的判断，原样透传，窗口化后没有独立健康含义",
  "status": "采集状态，窗口化就是 coverage（units 已有），不重复造",
  "point": "点测量，一个窗口里只有一个值，窗口化＝取最新（units 点观测已有）"
 },
 "operators": {
  "rate": "命中天数 ÷ 可判定天数。可判定＝该断言的全部 inputs 当天都有值（prev=true 时还要求前一日有值）",
  "run": "段结构：命中日按日历相邻切成段，给段数与最长段。成立的判据见 min_run_ref"
 },
 "side_operators": {
  "integral": "跨日累积超出量：Σ 越过判读线的部分（'above' 方向取缺额，'below' 方向取超额）。挂在结论上，不单独成 id",
  "trend": "跨日斜率：units.slope，门槛＝mdc_change ÷ sqrt(n)（日级门槛搬到窗口级必须按 √n 收缩，否则真实趋势会被判成「在误差内」）"
 },
 "states": {
  "成立": "发生率 ≥ rules.units.daily_ok_rate（默认 0.6）且可判定天数 ≥ min_n",
  "参半": "发生率落在 (1-ok_rate, ok_rate) 之间——两边都不占多数，不给「常态」这种话",
  "不成立": "发生率 ≤ 1-ok_rate 且样本够",
  "不可判定": "可判定天数不足 min_n，或该窗口的算子不适用。此时仍给 hit/decidable，只是不给措辞"
 },
